# Reference only - copy the keys you need into backend/.env (never commit real values).

NODE_ENV=development
PORT=5000

# Render / reverse proxies: hop count (e.g. 1), loopback, false, or true
TRUST_PROXY=loopback

DB_HOST=localhost
DB_PORT=5432
DB_NAME=Aarogya
DB_USER=postgres
DB_PASSWORD=change-me

# Managed Postgres (Render, etc.): disable | require | verify-full
DB_SSL=disable
# Optional when DB_SSL=verify-full:
# DB_SSL_CA=
# DB_SSL_CA_FILE=

# Exact Postgres database name trusted for 003 production verification.
# Leave unset to use "Aarogya". On Render, set to the exact generated DB name
# (must match current_database(); never point this at aarogya_test).
# MIGRATION_TRUSTED_DATABASE_NAME=

# Required together with CLI --approve-003-promote-bootstrap to execute migration 003.
# Leave unset for normal runs. Exact value only:
# MIGRATE_APPROVE_003=PROMOTE_BOOTSTRAP
# To promote bootstrap WITHOUT running 004+: also pass --only-003-promote-bootstrap
# (requires MIGRATION_TRUSTED_DATABASE_NAME set to the exact current_database() name).

# At least 32 bytes
JWT_SECRET=change-me-to-a-long-random-secret-of-32-bytes-or-more
JWT_EXPIRES_IN=15m

# Sliding refresh-session lifetime (httpOnly cookie)
REFRESH_TOKEN_TTL_HOURS=12

# REQUIRED for MFA roles (Super/System/District Admin, Medical Officer, Specialist).
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable: changing it invalidates every enrolled authenticator.
MFA_ENCRYPTION_KEY=

# console (development only: link printed in the server console) | none | email | sms
# email/sms providers are not configured yet.
PASSWORD_RESET_DELIVERY=console

FRONTEND_URL=http://localhost:3000

# Optional: absolute or cwd-relative path to the CRA build folder (must contain index.html).
# Defaults: backend/public, then ../frontend/build. Use after npm run sync:frontend on Render.
# FRONTEND_BUILD_PATH=

# Private Supabase Storage (backend only; never use REACT_APP_ variables).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=aarogya-patient-images

# Internal AI pipeline (Express -> FastAPI). Token must match aipipe and be >= 32 chars.
AI_PIPELINE_URL=https://aarogya-aipipe.onrender.com
AI_PIPELINE_AUTH_TOKEN=change-me-to-a-shared-secret-at-least-32-chars
# Optional timeouts (ms):
# AI_PIPELINE_HEALTH_TIMEOUT_MS=5000
# AI_PIPELINE_ANALYSIS_TIMEOUT_MS=600000

# Account setup link encryption (required): 32 random bytes, base64.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETUP_TOKEN_ENCRYPTION_KEY=

# District Admin setup invitation email (SMTP). SMTP_SECURE must be true or false.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

SYSTEM_ADMIN_USERNAME=systemadmin
SYSTEM_ADMIN_PASSWORD=change-me
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_FULL_NAME=Aarogya Drishti System Administrator

# Public Jitsi Meet (no self-hosted JWT). Backend only — never put these in REACT_APP_*.
# meet.jit.si rooms are public: our API decides who receives the room name, but
# anyone who learns the room name may attempt to join on the public server.
VIDEO_PROVIDER=jitsi
JITSI_DOMAIN=meet.jit.si

# Sarvam AI Speech (voice receptionist STT/TTS). Backend only — never put in REACT_APP_*.
# Required for Telugu / Hindi / English. Leave empty to disable speech APIs.
# STT: saaras:v4 | TTS: bulbul:v3 speakers te→neha, hi→priya, en→ishita
# SARVAM_API_KEY=

# Tests only - must point to the aarogya_test database
TEST_DATABASE_URL=postgres://postgres:change-me@localhost:5432/aarogya_test
