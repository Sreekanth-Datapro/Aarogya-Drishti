# Copy to backend/.env.test. Never use the production Aarogya database.
# Tests refuse to run unless all values identify the dedicated aarogya_test database.
# Do not point these at Aarogya, Render, or aarogya_defer003_test (migrate rehearsal only).
TEST_DATABASE_URL=postgresql://aarogya_test_user:password@127.0.0.1:5432/aarogya_test
TEST_DB_EXPECTED_NAME=aarogya_test
TEST_DB_EXPECTED_HOST=127.0.0.1
TEST_DB_EXPECTED_PORT=5432
TEST_DB_EXPECTED_USER=aarogya_test_user
TEST_DB_EXPECTED_SERVER_ADDRESS=127.0.0.1
TEST_DB_ALLOW_DESTRUCTIVE_RESET=false
# Required for Jest globalSetup isolated-test 003 harness (not SYSTEM_ADMIN_PASSWORD).
TEST_INTEGRATION_BOOTSTRAP_PASSWORD=TestBootstrap1
