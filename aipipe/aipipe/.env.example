# Reference only - copy into aipipe/aipipe/.env (never commit real values).
# Must match backend AI_PIPELINE_AUTH_TOKEN (at least 32 characters).

PORT=8010
AI_PIPELINE_AUTH_TOKEN=change-me-to-a-shared-secret-at-least-32-chars

# Cloudflare Workers AI (vision). Leave blank only for local stubs/tests.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_AUTH_TOKEN=your-cloudflare-api-token
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
CLOUDFLARE_AI_TIMEOUT_SECONDS=120

# Optional: enable uvicorn auto-reload in local development (1|true|yes)
UVICORN_RELOAD=
